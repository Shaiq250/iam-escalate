{
  "UserDetailList": [
    {
      "UserName": "lambda-only-lily",
      "Arn": "arn:aws:iam::123456789012:user/lambda-only-lily",
      "UserPolicyList": [
        {
          "PolicyName": "pass-lambda-only",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": ["lambda:CreateFunction", "lambda:InvokeFunction", "ecs:RunTask"],
                "Resource": "*"
              },
              {
                "Effect": "Allow",
                "Action": "iam:PassRole",
                "Resource": "*",
                "Condition": {"StringEquals": {"iam:PassedToService": "lambda.amazonaws.com"}}
              }
            ]
          }
        }
      ],
      "AttachedManagedPolicies": [],
      "GroupList": []
    }
  ],
  "GroupDetailList": [],
  "RoleDetailList": [
    {
      "RoleName": "target-role",
      "Arn": "arn:aws:iam::123456789012:role/target-role",
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {"Service": ["lambda.amazonaws.com", "ecs-tasks.amazonaws.com"]},
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "RolePolicyList": [
        {
          "PolicyName": "admin",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {"Effect": "Allow", "Action": "iam:AttachUserPolicy", "Resource": "*"}
            ]
          }
        }
      ],
      "AttachedManagedPolicies": []
    }
  ],
  "Policies": []
}
