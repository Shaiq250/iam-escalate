{
  "UserDetailList": [
    {
      "UserName": "lambda-larry",
      "Arn": "arn:aws:iam::123456789012:user/lambda-larry",
      "UserPolicyList": [
        {
          "PolicyName": "pass-and-run",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": ["iam:PassRole", "lambda:CreateFunction", "lambda:InvokeFunction"],
                "Resource": "*"
              }
            ]
          }
        }
      ],
      "AttachedManagedPolicies": [],
      "GroupList": []
    },
    {
      "UserName": "half-harry",
      "Arn": "arn:aws:iam::123456789012:user/half-harry",
      "UserPolicyList": [
        {
          "PolicyName": "pass-only",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {"Effect": "Allow", "Action": "iam:PassRole", "Resource": "*"}
            ]
          }
        }
      ],
      "AttachedManagedPolicies": [],
      "GroupList": []
    }
  ],
  "GroupDetailList": [],
  "RoleDetailList": [
    {
      "RoleName": "powerful-role",
      "Arn": "arn:aws:iam::123456789012:role/powerful-role",
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {"Service": "lambda.amazonaws.com"},
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "RolePolicyList": [
        {
          "PolicyName": "pw",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {"Effect": "Allow", "Action": "iam:AttachUserPolicy", "Resource": "*"}
            ]
          }
        }
      ],
      "AttachedManagedPolicies": []
    }
  ],
  "Policies": []
}
